{
  "author": "@ice-chillios",
  "bin": { "atlas": "./dist/cli.js" },
  "dependencies": { "@r5n/cli-core": "workspace:*", "banditypes": "0.3.0" },
  "description": "Atlas CLI - Profile-based env composition for apps and environments",
  "devDependencies": { "@r5n/tools": "workspace:*" },
  "files": ["dist", "LICENSE"],
  "keywords": ["cli", "dotenv", "env", "config", "profiles"],
  "license": "Apache-2.0",
  "main": "dist/cli.js",
  "name": "@r5n/atlas",
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "repository": { "type": "git", "url": "git+https://github.com/r5n-labs/clis.git" },
  "scripts": {
    "build": "rm -rf dist && bun build.ts",
    "clean": "rm -rf dist node_modules",
    "dev": "bun --bun src/cli.ts",
    "package:dryRun": "bun run package:prepare && bun publish --dry-run --no-git-checks --access public --force && bun install",
    "package:prepare": "NODE_ENV=production bun run build && bun ../../tools/scripts/prepare-publish.ts .",
    "package:publish": "bun run package:prepare && bun publish --access public --no-git-checks && bun install",
    "type-check": "bun --bun tsc --noEmit",
    "type-check:go": "tsgo"
  },
  "type": "module",
  "types": "src/cli.ts",
  "version": "0.1.0"
}
