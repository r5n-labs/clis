{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Argus configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "root", "questions"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "root": { "type": "string", "minLength": 1, "description": "Project root, relative to this config file" },
    "model": { "type": "string", "minLength": 1, "default": "jev-1.13.0" },
    "include": { "$ref": "#/$defs/strings" },
    "exclude": { "$ref": "#/$defs/strings" },
    "maxQuestions": { "type": "integer", "minimum": 1, "default": 32 },
    "maxRequestBytes": { "type": "integer", "minimum": 1, "default": 100000 },
    "questions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "methods": { "$ref": "#/$defs/questions" },
        "classes": { "$ref": "#/$defs/questions" },
        "files": { "$ref": "#/$defs/questions" },
        "tests": { "$ref": "#/$defs/questions" },
        "resources": { "$ref": "#/$defs/questions" },
        "translations": { "$ref": "#/$defs/questions" },
        "changes": { "$ref": "#/$defs/questions" }
      }
    }
  },
  "$defs": {
    "strings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "questions": { "type": "array", "items": { "$ref": "#/$defs/question" } },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "instructions", "criteria"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "const": "choice" },
        "instructions": { "type": "string", "minLength": 1 },
        "criteria": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "context": { "enum": ["target", "class", "references", "file"], "default": "class" },
        "contextFiles": { "$ref": "#/$defs/strings" },
        "include": { "$ref": "#/$defs/strings" },
        "hasComments": { "type": "boolean", "default": false },
        "flag": { "$ref": "#/$defs/strings" },
        "minConfidence": { "type": "number", "minimum": 0, "maximum": 1, "default": 0 },
        "minConcernProbability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Also flag when the summed probability of flagged choices reaches this threshold. Omit to disable."
        }
      }
    }
  }
}
