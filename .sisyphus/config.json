{
  "$schema": "https://raw.githubusercontent.com/r5n-labs/clis/refs/heads/develop/packages/sisyphus/schema.json",
  "changelog": {
    "append": true,
    "filename": "CHANGELOG.md",
    "generate": true,
    "packageHeader": "{emoji} {version} ({date})",
    "root": true,
    "rootHeader": "{date} - {packages}",
    "sections": {
      "breaking": "Breaking changes",
      "build": "Build",
      "chore": "Chores",
      "ci": "CI",
      "dependencies": "Dependency updates",
      "docs": "Documentation",
      "feat": "Features",
      "fix": "Bug fixes",
      "other": "Other changes",
      "perf": "Performance",
      "refactor": "Refactoring",
      "style": "Styling",
      "test": "Tests"
    }
  },
  "commit": {
    "author": "Sisyphus",
    "email": "237849083+r5n-bot@users.noreply.github.com",
    "message": "release(🎉): {message}"
  },
  "commits": {
    "skip": {
      "authors": ["r5n-bot[bot]", "Sisyphus", "r5n-bot"],
      "messagePatterns": ["^chore\\(release\\):", "^chore: add stone"]
    }
  },
  "dependents": {
    "kinds": ["dependencies", "devDependencies", "optionalDependencies", "peerDependencies"],
    "updateInternal": "always"
  },
  "ignore": [],
  "lastStone": { "commit": "11d66da4820d7d70a2ebea536771e20a136bcec4", "date": "2026-10-05T07:14:04.909Z" },
  "plugins": [],
  "pr": {
    "labelMapping": {
      "breaking": "major",
      "breaking-change": "major",
      "bug": "patch",
      "chore": "patch",
      "docs": "patch",
      "enhancement": "minor",
      "feature": "minor",
      "fix": "patch"
    },
    "skip": {
      "authors": ["r5n-bot[bot]", "Sisyphus", "r5n-bot"],
      "labels": ["sisyphus-release", "skip-stone"],
      "titlePatterns": ["^chore\\(release\\):"]
    }
  },
  "release": {
    "build": { "command": ["bun", "run", "build"], "outputs": ["packages/*/dist/**"], "root": [] },
    "createRelease": false,
    "npm": true,
    "npmVisibilityTimeout": 300,
    "push": true,
    "tags": true
  },
  "scripts": { "post": {}, "pre": {} },
  "single": false,
  "sisyphusDir": ".sisyphus",
  "stones": [],
  "tag": "latest"
}
